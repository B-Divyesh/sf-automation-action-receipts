{
  "name": "automation-action-receipts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:site": "vite build",
    "build:cli": "cargo build --release && node scripts/copy-binary.mjs",
    "build": "npm run build:site && npm run build:cli",
    "test:cli": "cargo test --all-targets",
    "test:unit": "vitest run",
    "test": "npm run test:cli && npm run test:unit",
    "test:e2e": "playwright test",
    "check": "cargo fmt --check && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/node": "24.3.0",
    "playwright": "1.58.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
