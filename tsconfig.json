{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "site/src/**/*.ts",
    "site/test/**/*.ts",
    "tests/e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
